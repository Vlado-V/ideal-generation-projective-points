theorem rowScale_ne_zero : ∀ i, rowScale i ≠ 0 := by decide +kernel

/-- The cleared integer matrix has a nonzero determinant. -/
theorem integralEvaluation_det_ne_zero : integralEvaluation.det ≠ 0 := by
  intro hzero
  have hdet := congrArg Matrix.det integral_inverse_mul
  rw [Matrix.det_mul, Matrix.det_smul, Matrix.det_one, mul_one, hzero, mul_zero] at hdet
  exact (pow_ne_zero _ inverseScale_ne_zero) hdet.symm

/-- The rational pair matrix obtained by undoing the positive row scalings. -/
def rationalEvaluation : Matrix (Fin 26) (Fin 26) ℚ :=
  Matrix.of fun i j => (integralEvaluation i j : ℚ) / (rowScale i : ℚ)

theorem rowScaleMatrix_mul :
    Matrix.diagonal (fun i => (rowScale i : ℚ)) * rationalEvaluation =
      integralEvaluation.map (Int.castRingHom ℚ) := by
  ext i j
  rw [Matrix.diagonal_mul]
  exact mul_div_cancel₀ _ (by exact_mod_cast rowScale_ne_zero i)

/-- Undoing row scalings preserves the certified nonzero determinant. -/
theorem rationalEvaluation_det_ne_zero : rationalEvaluation.det ≠ 0 := by
  have hint : (integralEvaluation.map (Int.castRingHom ℚ)).det ≠ 0 := by
    change (integralEvaluation.map (fun x : ℤ => (x : ℚ))).det ≠ 0
    rw [← Int.cast_det]
    exact_mod_cast integralEvaluation_det_ne_zero
  intro hzero
  apply hint
  rw [← rowScaleMatrix_mul, Matrix.det_mul, hzero, mul_zero]

