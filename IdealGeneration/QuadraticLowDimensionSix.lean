/-- General quadrics in 6 homogeneous variables have the required rank. -/
theorem quadratic_six_all {K : Type*} [Field K] [CharZero K] :
    ∀ p, IdealGenerationAt K 5 2 p := by
  have he : E 6 2 = 7 := by norm_num [E, N, Nat.choose]
  have hl : lowerCritical 6 2 = 7 := by simp [lowerCritical, he]
  have hu : upperCritical 6 2 = 7 := by simp [upperCritical, he]
  apply idealGenerationAt_all_of_critical (by decide : 1 ≤ 5) (by decide : 1 ≤ 2)
  · change IdealGenerationAt K 5 2 (N 6 2 - lowerCritical 6 2)
    rw [hl, show N 6 2 = 21 by decide]
    exact six_idealGenerationAt
  · change IdealGenerationAt K 5 2 (N 6 2 - upperCritical 6 2)
    rw [hu, show N 6 2 = 21 by decide]
    exact six_idealGenerationAt

end IdealGeneration.QuadraticLowDimension
