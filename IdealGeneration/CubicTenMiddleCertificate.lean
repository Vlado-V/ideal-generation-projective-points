def MRow (i : Fin 310) : SparseRow 310 ℕ := middleTables.target i

theorem targetM_apply (i j : Fin 310) :
    targetM i j = ((rowValue (MRow i) j : ℕ) : ZMod modulus) := rfl

def lowerM : Matrix (Fin 310) (Fin 310) (ZMod modulus) := residueMatrix modulus middleTables.lower
def upperM : Matrix (Fin 310) (Fin 310) (ZMod modulus) := residueMatrix modulus middleTables.upper

/-- A verified lower-upper factorization of the numerical middle minor. -/
