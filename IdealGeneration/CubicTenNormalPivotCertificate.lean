/-- The numerical scalar pivot matrix. -/
def normalPivot : Matrix (Fin 75) (Fin 75) (ZMod modulus) := residueMatrix modulus normalPivotTables.upper

/-- A numerical left inverse of the scalar pivot matrix. -/
def normalPivotInverse : Matrix (Fin 75) (Fin 75) (ZMod modulus) := residueMatrix modulus normalPivotTables.lower

def normalPivotRow (i : Fin 75) : SparseRow 75 ℕ := normalPivotTables.upper i

theorem normalPivot_apply (i j : Fin 75) :
    normalPivot i j = ((rowValue (normalPivotRow i) j : ℕ) : ZMod modulus) := rfl

/-- The scalar pivot inverse identity is checked by exact modular arithmetic. -/
theorem normal_pivot_leftInverse : normalPivotInverse * normalPivot = 1 := by
  unfold normalPivotInverse normalPivot
  rw [normalPivotTables.checked_product (by decide) normalPivotValid]
  ext i j
  change ((rowValue (normalPivotTables.target i) j : ℕ) : ZMod modulus) = _
  rw [normalPivotIdentity]
  by_cases hij : i = j <;> simp [rowValue, Matrix.one_apply, hij]

