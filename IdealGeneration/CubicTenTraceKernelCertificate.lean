/-- The numerical cubic evaluation matrix. -/
def ET : Matrix (Fin 90) (Fin 120) (ZMod modulus) :=
  fun i j => residueMatrix modulus traceKernelTables.lower (Fin.castLE (by decide) i) j

/-- The numerical basis matrix with monomial rows and basis columns. -/
def Kt : Matrix (Fin 120) (Fin 30) (ZMod modulus) :=
  fun i j => residueMatrix modulus traceKernelTables.upper i (Fin.castLE (by decide) j)

/-- Sparse natural residues in one numerical evaluation row. -/
def ETRow (i : Fin 90) : SparseRow 120 ℕ := traceKernelTables.lower (Fin.castLE (by decide) i)

/-- Sparse natural residues in one numerical basis row, padded by zeros. -/
def KtRow (i : Fin 120) : SparseRow 120 ℕ := traceKernelTables.upper i

theorem ET_apply (i : Fin 90) (j : Fin 120) :
    ET i j = ((rowValue (ETRow i) j : ℕ) : ZMod modulus) := rfl

theorem Kt_apply (i : Fin 120) (j : Fin 30) :
    Kt i j = ((rowValue (KtRow i) (Fin.castLE (by decide : 30 ≤ 120) j) : ℕ) : ZMod modulus) := rfl

private theorem traceKernel_padded_zero :
    residueMatrix modulus traceKernelTables.lower * residueMatrix modulus traceKernelTables.upper = 0 := by
  rw [traceKernelTables.checked_product (by decide) traceKernelValid]
  ext i j
  rfl

/-- The proposed basis columns satisfy the numerical evaluation constraints. -/
theorem trace_annihilation : ET * Kt = 0 := by
  ext i j
  have h := congrFun (congrFun traceKernel_padded_zero (Fin.castLE (by decide) i))
    (Fin.castLE (by decide) j)
  simpa only [ET, Kt, Matrix.mul_apply, Matrix.zero_apply] using h

