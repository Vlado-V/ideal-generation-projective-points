/-- The free coordinates of the proposed basis form an identity matrix. -/
theorem trace_free_identity : Kt.submatrix traceFreeRow id = 1 := by
  ext i j
  change ((rowValue (traceKernelTables.upper (traceFreeRow i))
    (Fin.castLE (by decide) j) : ℕ) : ZMod modulus) =
    (1 : Matrix (Fin 30) (Fin 30) (ZMod modulus)) i j
  rw [traceFreeIdentity]
  have he : (Fin.castLE (by decide : 30 ≤ 120) i = Fin.castLE (by decide) j) ↔ i = j := by
    constructor
    · intro h
      exact Fin.ext (congrArg (fun k : Fin 120 => k.val) h)
    · intro h
      subst j
      rfl
  by_cases hij : i = j <;> simp [rowValue, Matrix.one_apply, he, hij]

