/-- The numerical scalar pivot matrix. -/
def tracePivot : Matrix (Fin 90) (Fin 90) (ZMod modulus) := residueMatrix modulus tracePivotTables.upper

/-- A numerical left inverse of the scalar pivot matrix. -/
def tracePivotInverse : Matrix (Fin 90) (Fin 90) (ZMod modulus) := residueMatrix modulus tracePivotTables.lower

def tracePivotRow (i : Fin 90) : SparseRow 90 ℕ := tracePivotTables.upper i

theorem tracePivot_apply (i j : Fin 90) :
    tracePivot i j = ((rowValue (tracePivotRow i) j : ℕ) : ZMod modulus) := rfl

/-- The scalar pivot inverse identity is checked by exact modular arithmetic. -/
theorem trace_pivot_leftInverse : tracePivotInverse * tracePivot = 1 := by
  unfold tracePivotInverse tracePivot
  rw [tracePivotTables.checked_product (by decide) tracePivotValid]
  ext i j
  change ((rowValue (tracePivotTables.target i) j : ℕ) : ZMod modulus) = _
  rw [tracePivotIdentity]
  by_cases hij : i = j <;> simp [rowValue, Matrix.one_apply, hij]

