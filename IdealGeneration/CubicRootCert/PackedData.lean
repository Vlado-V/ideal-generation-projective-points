private def decodeQuotientDigits : Nat → Nat → List Nat
  | 0, _ => []
  | count + 1, code =>
    code % (2 ^ 30) :: decodeQuotientDigits count (code / (2 ^ 30))

private theorem decodeQuotientDigits_length (count code : Nat) :
    (decodeQuotientDigits count code).length = count := by
  induction count generalizing code with
  | zero => rfl
  | succ count ih => simp [decodeQuotientDigits, ih]

private theorem decodeQuotientDigits_all_lt (count code : Nat) :
    ((decodeQuotientDigits count code).all fun q => decide (q < 2 ^ 30)) = true := by
  induction count generalizing code with
  | zero => rfl
  | succ count ih =>
    simpa only [decodeQuotientDigits, List.all_cons, ih, Bool.and_true, decide_eq_true_eq]
      using (Nat.mod_lt code (by decide : 0 < 2 ^ 30))

noncomputable def quotientRows (i : Fin 160) : List Nat :=
  decodeQuotientDigits 160 (quotientCode i)

theorem quotientRows_length (i : Fin 160) : (quotientRows i).length = 160 :=
  decodeQuotientDigits_length _ _

theorem quotientRows_all_lt (i : Fin 160) :
    ((quotientRows i).all fun q => decide (q < 2 ^ 30)) = true :=
  decodeQuotientDigits_all_lt _ _

abbrev SparseRowBound (row : SparseRow 160 Nat) : Prop :=
  row.length ≤ 160 ∧ (row.all fun e => decide (e.2 < 1009)) = true

structure PackedRowFacts (i : Fin 160) : Prop where
  lowerBound : SparseRowBound (lowerRows i)
  upperBound : SparseRowBound (upperRows i)
  targetBound : SparseRowBound (targetRows i)
  lowerSupport : (lowerRows i).all (fun e => decide (e.1 ≤ i)) = true
  upperSupport : (upperRows i).all (fun e => decide (i ≤ e.1)) = true
  lowerDiagonal : rowValue (lowerRows i) i % 1009 ≠ 0
  upperDiagonal : rowValue (upperRows i) i % 1009 ≠ 0
  columnLeftInverse : inverseMinorColumns (minorColumns i) = i
  columnRightInverse : minorColumns (inverseMinorColumns i) = i

end IdealGeneration.CubicSupported.C2RootCertificate
