  have he : E 12 2 = 26 := by norm_num [E, N, Nat.choose]
  have hl : lowerCritical 12 2 = 26 := by simp [lowerCritical, he]
  have hu : upperCritical 12 2 = 26 := by simp [upperCritical, he]
  apply idealGenerationAt_all_of_critical (by decide : 1 ≤ 11) (by decide : 1 ≤ 2)
  · change IdealGenerationAt K 11 2 (N 12 2 - lowerCritical 12 2)
    rw [hl, show N 12 2 = 78 by decide]
    exact twelve_idealGenerationAt
  · change IdealGenerationAt K 11 2 (N 12 2 - upperCritical 12 2)
    rw [hu, show N 12 2 = 78 by decide]
    exact twelve_idealGenerationAt

end IdealGeneration.QuadraticLowDimension
