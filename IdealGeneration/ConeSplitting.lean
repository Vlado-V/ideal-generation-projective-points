module

public import IdealGeneration.ConeRepresentatives
public import IdealGeneration.ConeLinear
public import Mathlib.LinearAlgebra.Basis.VectorSpace

@[expose] public section

set_option backward.privateInPublic true
set_option backward.privateInPublic.warn false
set_option backward.proofsInPublic true


/-!
# Coordinate cone splitting

The first `c` variables are normal coordinates and the remaining `m` variables
are trace coordinates. All spaces below consist of actual homogeneous
polynomials and all vanishing conditions use their evaluations.
-/

noncomputable section
namespace IdealGeneration
open MvPolynomial

variable (K : Type*) [Field K] (c m : ℕ)

/-- Set all normal coordinates to zero. -/
def coneRestrict : Poly K (c + m) →ₐ[K] Poly K m :=
  MvPolynomial.aeval (Fin.addCases (fun _ : Fin c => 0) (fun j : Fin m => X j))

/-- Regard a trace polynomial as a polynomial in all coordinates. -/
def coneExtend : Poly K m →ₐ[K] Poly K (c + m) :=
  MvPolynomial.rename (Fin.natAdd c)

@[simp] theorem coneRestrict_X_normal (i : Fin c) :
    coneRestrict K c m (X (i.castAdd m)) = 0 := by simp [coneRestrict]

@[simp] theorem coneRestrict_X_trace (i : Fin m) :
    coneRestrict K c m (X (i.natAdd c)) = X i := by simp [coneRestrict]

@[simp] theorem coneExtend_X (i : Fin m) :
    coneExtend K c m (X i) = X (i.natAdd c) := by simp [coneExtend]

@[simp] theorem coneRestrict_extend (f : Poly K m) :
    coneRestrict K c m (coneExtend K c m f) = f := by
  have h : (coneRestrict K c m).comp (coneExtend K c m) = AlgHom.id K _ := by
    ext i
    simp
  exact congrArg (fun F : Poly K m →ₐ[K] Poly K m => F f) h

/-- The ideal generated by the actual normal-coordinate variables. -/
def coneNormalIdeal : Ideal (Poly K (c + m)) :=
  Ideal.span (Set.range (fun i : Fin c => X (i.castAdd m)))

theorem sub_coneExtend_restrict_mem (f : Poly K (c + m)) :
    f - coneExtend K c m (coneRestrict K c m f) ∈ coneNormalIdeal K c m := by
  let q : Fin (c + m) → Poly K (c + m) :=
    Fin.addCases (fun _ : Fin c => 0) (fun j : Fin m => X (j.natAdd c))
  have hq : ∀ i, X i - q i ∈ coneNormalIdeal K c m := by
    intro i
    refine Fin.addCases (fun j => ?_) (fun j => ?_) i
    · simpa [q, coneNormalIdeal] using Ideal.subset_span (s := Set.range (fun j : Fin c =>
        (X (j.castAdd m) : Poly K (c + m)))) ⟨j, rfl⟩
    · simp [q]
  have heq : (coneExtend K c m).toRingHom.comp (coneRestrict K c m).toRingHom =
      eval₂Hom C q := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [coneExtend, coneRestrict]
    · intro i
      refine Fin.addCases (fun j => ?_) (fun j => ?_) i <;> simp [q]
  have hs := sub_substitution_mem (coneNormalIdeal K c m) q hq f
  change f - (eval₂Hom C q) f ∈ coneNormalIdeal K c m at hs
  rw [← heq] at hs
  exact hs

theorem coneRestrict_eq_zero_iff (f : Poly K (c + m)) :
    coneRestrict K c m f = 0 ↔ f ∈ coneNormalIdeal K c m := by
  constructor
  · intro hf
    simpa [hf] using sub_coneExtend_restrict_mem K c m f
  · intro hf
    have hle : coneNormalIdeal K c m ≤ RingHom.ker (coneRestrict K c m).toRingHom := by
      apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      simp
    exact hle hf

theorem coneRestrict_homogeneous {d : ℕ} {f : Poly K (c + m)}
    (hf : f.IsHomogeneous d) : (coneRestrict K c m f).IsHomogeneous d := by
  simpa only [one_mul, coneRestrict] using hf.aeval (n := 1)
    (Fin.addCases (fun _ : Fin c => 0) (fun j : Fin m => X j))
    (by intro i; refine Fin.addCases (fun _ => ?_) (fun j => ?_) i
        · simpa only [Fin.addCases_left] using (isHomogeneous_zero (σ := Fin m) (R := K) 1)
        · simpa only [Fin.addCases_right] using (isHomogeneous_X K j))

/-- Homogeneous coordinate restriction. -/
def coneRestrictForm (d : ℕ) : Forms K (c + m) d →ₗ[K] Forms K m d where
  toFun f := ⟨coneRestrict K c m f.val, coneRestrict_homogeneous K c m f.property⟩
  map_add' _ _ := Subtype.ext (map_add _ _ _)
  map_smul' _ _ := Subtype.ext (map_smul _ _ _)

/-- Homogeneous coordinate extension. -/
def coneExtendForm (d : ℕ) : Forms K m d →ₗ[K] Forms K (c + m) d where
  toFun f := ⟨coneExtend K c m f.val, f.property.rename_isHomogeneous⟩
  map_add' _ _ := Subtype.ext (map_add _ _ _)
  map_smul' _ _ := Subtype.ext (map_smul _ _ _)

@[simp] theorem coneRestrictForm_extendForm {d : ℕ} (f : Forms K m d) :
    coneRestrictForm K c m d (coneExtendForm K c m d f) = f := by
  apply Subtype.ext
  exact coneRestrict_extend K c m f.val

/-- Evaluation of a pure trace polynomial only uses the trace coordinates. -/
theorem eval_coneExtend (f : Poly K m) (x : Fin (c + m) → K) :
    eval x (coneExtend K c m f) = eval (fun j => x (j.natAdd c)) f :=
  MvPolynomial.eval_rename _ _ _

/-- Evaluation of a restriction equals evaluation on the trace coordinate subspace. -/
theorem eval_coneRestrict (f : Poly K (c + m)) (x : Fin m → K) :
    eval x (coneRestrict K c m f) =
      eval (Fin.addCases (fun _ : Fin c => 0) x) f := by
  have h : (eval x).comp (coneRestrict K c m).toRingHom =
      eval (Fin.addCases (fun _ : Fin c => 0) x) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [coneRestrict]
    · intro i
      refine Fin.addCases (fun j => ?_) (fun j => ?_) i <;> simp
  exact congrArg (fun F : Poly K (c + m) →+* K => F f) h

/-- Restriction of coordinate multiplication retains exactly the trace variables. -/
theorem coneRestrictForm_multiplication {d : ℕ} (f : Fin (c + m) → Forms K (c + m) d) :
    coneRestrictForm K c m (d + 1) (formMultiplication K (c + m) d f) =
      formMultiplication K m d (fun j => coneRestrictForm K c m d (f (j.natAdd c))) := by
  apply Subtype.ext
  simp [coneRestrictForm, formMultiplication, Fin.sum_univ_add]

/-- A marked cone configuration. Its trace projection has the prescribed support. -/
structure ConeConfiguration (p q : ℕ) where
  trace : Fin q → Fin m → K
  normal : Fin p → Fin c → K
  support : Fin p → Fin q
  height : Fin p → K

namespace ConeConfiguration
variable {K c m} {p q d : ℕ} (C : ConeConfiguration K c m p q)

/-- Cone point representatives. -/
def point (i : Fin p) : Fin (c + m) → K :=
  Fin.addCases (C.normal i) (fun j => C.height i * C.trace (C.support i) j)

/-- Trace points embedded with zero normal coordinates. -/
def tracePoint (i : Fin q) : Fin (c + m) → K :=
  Fin.addCases (fun _ : Fin c => 0) (C.trace i)

/-- Trace equations in the trace polynomial ring. -/
def tracePiece (d : ℕ) : Submodule K (Forms K m d) :=
  representativePiece K C.trace d

/-- Cone equations, before imposing the trace points. -/
def conePiece (d : ℕ) : Submodule K (Forms K (c + m) d) :=
  representativePiece K C.point d

/-- Equations of the union of cone points and trace points. -/
def unionPiece (d : ℕ) : Submodule K (Forms K (c + m) d) :=
  C.conePiece d ⊓ representativePiece K C.tracePoint d

/-- The ordered union of cone and embedded trace representatives. -/
def representatives : Fin (p + q) → Fin (c + m) → K :=
  Fin.addCases C.point C.tracePoint

/-- A nonzero normal direction makes its cone representative nonzero. -/
theorem point_ne_zero (i : Fin p) (h : C.normal i ≠ 0) : C.point i ≠ 0 := by
  intro hz
  apply h
  funext j
  have hj := congrFun hz (j.castAdd m)
  simpa [point] using hj

/-- Every nonzero trace representative stays nonzero after its embedding. -/
theorem tracePoint_ne_zero (i : Fin q) (h : C.trace i ≠ 0) : C.tracePoint i ≠ 0 := by
  intro hz
  apply h
  funext j
  have hj := congrFun hz (j.natAdd c)
  simpa [tracePoint] using hj

/-- The projective chart-transport hypothesis follows from the ordinary
nonzero direction and nonzero trace-point hypotheses. -/
theorem representatives_ne_zero (hnormal : ∀ i, C.normal i ≠ 0)
    (htrace : ∀ i, C.trace i ≠ 0) : ∀ i, C.representatives i ≠ 0 := by
  intro i
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i
  · simpa [representatives] using C.point_ne_zero j (hnormal j)
  · simpa [representatives] using C.tracePoint_ne_zero j (htrace j)

/-- The intersection defining the cone union is exactly the equations of its
ordered union of representatives. -/
theorem unionPiece_eq_representativePiece (d : ℕ) :
    C.unionPiece d = representativePiece K C.representatives d := by
  ext f
  change (f ∈ C.conePiece d ∧ f ∈ representativePiece K C.tracePoint d) ↔ _
  simp only [conePiece, mem_representativePiece]
  constructor
  · rintro ⟨hf, hg⟩ i
    refine Fin.addCases (fun j => ?_) (fun j => ?_) i
    · simpa [representatives] using hf j
    · simpa [representatives] using hg j
  · intro h
    exact ⟨fun i => by simpa [representatives] using h (i.castAdd q),
      fun i => by simpa [representatives] using h (i.natAdd p)⟩

/-- Normal-ideal equations of the cone points. -/
def residualPiece (d : ℕ) : Submodule K (Forms K (c + m) d) :=
  C.conePiece d ⊓ LinearMap.ker (coneRestrictForm K c m d)

@[simp] theorem mem_tracePiece (f : Forms K m d) :
    f ∈ C.tracePiece d ↔ ∀ i, eval (C.trace i) f.val = 0 :=
  mem_representativePiece K C.trace f

@[simp] theorem mem_conePiece (f : Forms K (c + m) d) :
    f ∈ C.conePiece d ↔ ∀ i, eval (C.point i) f.val = 0 :=
  mem_representativePiece K C.point f

/-- A pure trace equation also vanishes at every marked cone point. -/
theorem extend_vanishes_cone (f : Forms K m d) (hf : f ∈ C.tracePiece d) :
    coneExtendForm K c m d f ∈ C.conePiece d := by
  apply (C.mem_conePiece _).mpr
  intro i
  change eval (C.point i) (coneExtend K c m f.val) = 0
  rw [eval_coneExtend]
  simp only [point, Fin.addCases_right]
  rw [homogeneous_eval_scale f.property, (C.mem_tracePiece f).mp hf]
  simp

theorem restrict_mem_trace (f : Forms K (c + m) d) (hf : f ∈ C.unionPiece d) :
    coneRestrictForm K c m d f ∈ C.tracePiece d := by
  apply (C.mem_tracePiece _).mpr
  intro i
  exact (eval_coneRestrict K c m f.val (C.trace i)).trans
    ((mem_representativePiece K C.tracePoint f).mp hf.2 i)

theorem extend_mem_union (f : Forms K m d) (hf : f ∈ C.tracePiece d) :
    coneExtendForm K c m d f ∈ C.unionPiece d := by
  refine ⟨C.extend_vanishes_cone f hf, ?_⟩
  apply (mem_representativePiece K C.tracePoint _).mpr
  intro i
  change eval (C.tracePoint i) (coneExtend K c m f.val) = 0
  rw [eval_coneExtend]
  simpa [tracePoint] using (C.mem_tracePiece f).mp hf i

/-- The residual summand is the degree piece of the normal ideal intersected
with the cone-point equations. -/
theorem mem_residualPiece_iff (f : Forms K (c + m) d) :
    f ∈ C.residualPiece d ↔
      f ∈ C.conePiece d ∧ f.val ∈ coneNormalIdeal K c m := by
  change (f ∈ C.conePiece d ∧ coneRestrictForm K c m d f = 0) ↔ _
  rw [← coneRestrict_eq_zero_iff]
  constructor
  · rintro ⟨hf, hr⟩
    exact ⟨hf, congrArg Subtype.val hr⟩
  · rintro ⟨hf, hr⟩
    exact ⟨hf, Subtype.ext hr⟩

theorem residual_mem_union (f : Forms K (c + m) d) (hf : f ∈ C.residualPiece d) :
    f ∈ C.unionPiece d := by
  refine ⟨hf.1, ?_⟩
  apply (mem_representativePiece K C.tracePoint f).mpr
  intro i
  have hz : coneRestrict K c m f.val = 0 := congrArg Subtype.val hf.2
  change eval (Fin.addCases (fun _ : Fin c => 0) (C.trace i)) f.val = 0
  rw [← eval_coneRestrict K c m f.val (C.trace i), hz, map_zero]

 theorem union_inf_ker_eq_residual (d : ℕ) :
    C.unionPiece d ⊓ LinearMap.ker (coneRestrictForm K c m d) = C.residualPiece d := by
  ext f
  constructor
  · intro hf
    exact ⟨hf.1.1, hf.2⟩
  · intro hf
    exact ⟨C.residual_mem_union f hf, hf.2⟩

/-- The ideal of the union splits canonically into lifted trace equations and
normal-ideal cone equations, in every homogeneous degree. -/
def split (d : ℕ) : C.unionPiece d ≃ₗ[K] C.tracePiece d × C.residualPiece d :=
  (submoduleSectionKernelEquiv (coneRestrictForm K c m d) (coneExtendForm K c m d)
    (coneRestrictForm_extendForm K c m) (C.unionPiece d) (C.tracePiece d)
    (C.restrict_mem_trace) (C.extend_mem_union)).trans
      (LinearEquiv.prodCongr (LinearEquiv.refl K _) (LinearEquiv.ofEq _ _
        (C.union_inf_ker_eq_residual d)))

@[simp] theorem split_fst (f : C.unionPiece d) :
    (C.split d f).1.val = coneRestrictForm K c m d f.val := rfl

@[simp] theorem split_snd (f : C.unionPiece d) :
    (C.split d f).2.val = f.val -
      coneExtendForm K c m d (coneRestrictForm K c m d f.val) := rfl

@[simp] theorem split_symm_val (f : C.tracePiece d × C.residualPiece d) :
    ((C.split d).symm f).val = coneExtendForm K c m d f.1.val + f.2.val := rfl

/-- The two summands give an internal direct sum of actual polynomial spaces. -/
theorem unionPiece_eq_sup (d : ℕ) :
    C.unionPiece d = (C.tracePiece d).map (coneExtendForm K c m d) ⊔ C.residualPiece d := by
  rw [← C.union_inf_ker_eq_residual d]
  exact submodule_eq_map_sup_inf_ker (coneRestrictForm K c m d) (coneExtendForm K c m d)
    (coneRestrictForm_extendForm K c m) (C.unionPiece d) (C.tracePiece d)
    (C.restrict_mem_trace) (C.extend_mem_union)

theorem trace_residual_disjoint (d : ℕ) :
    Disjoint ((C.tracePiece d).map (coneExtendForm K c m d)) (C.residualPiece d) := by
  rw [← C.union_inf_ker_eq_residual d]
  exact disjoint_map_inf_ker_of_section (coneRestrictForm K c m d) (coneExtendForm K c m d)
    (coneRestrictForm_extendForm K c m) (C.unionPiece d) (C.tracePiece d)

/-- The splitting gives the sum of dimensions without a rank hypothesis. -/
theorem finrank_unionPiece (d : ℕ) :
    Module.finrank K (C.unionPiece d) =
      Module.finrank K (C.tracePiece d) + Module.finrank K (C.residualPiece d) := by
  exact finrank_eq_add_of_linearEquiv (K := K) (V := C.unionPiece d)
    (W := C.tracePiece d) (U := C.residualPiece d) (C.split d)

/-- Coordinate multiplication on the equations of the union. -/
def multiplication (d : ℕ) :
    (Fin (c + m) → C.unionPiece d) →ₗ[K] C.unionPiece (d + 1) where
  toFun f := ⟨formMultiplication K (c + m) d (fun j => (f j).val), by
    constructor
    · exact (representativeMultiplication K C.point d (fun j =>
        ⟨(f j).val, (f j).property.1⟩)).property
    · exact (representativeMultiplication K C.tracePoint d (fun j =>
        ⟨(f j).val, (f j).property.2⟩)).property⟩
  map_add' f g := by
    apply Subtype.ext
    exact (formMultiplication K (c + m) d).map_add _ _
  map_smul' a f := by
    apply Subtype.ext
    exact (formMultiplication K (c + m) d).map_smul a _

/-- Canonical identification with equations of an ordered representative family. -/
def representativeEquiv (d : ℕ) :
    C.unionPiece d ≃ₗ[K] representativePiece K C.representatives d :=
  LinearEquiv.ofEq _ _ (C.unionPiece_eq_representativePiece d)

/-- The cone multiplication uses the same coordinate map as arbitrary
representative multiplication. -/
theorem representativeEquiv_multiplication (d : ℕ) (f : Fin (c + m) → C.unionPiece d) :
    C.representativeEquiv (d + 1) (C.multiplication d f) =
      representativeMultiplication K C.representatives d
        (fun i => C.representativeEquiv d (f i)) := by
  apply Subtype.ext
  apply Subtype.ext
  rfl

/-- The trace block is ordinary multiplication of trace equations. -/
def traceMultiplication (d : ℕ) :
    (Fin m → C.tracePiece d) →ₗ[K] C.tracePiece (d + 1) :=
  representativeMultiplication K C.trace d

/-- Multiply the normal-ideal cone equations by every ambient coordinate. -/
def residualMultiplication (d : ℕ) :
    (Fin (c + m) → C.residualPiece d) →ₗ[K] C.residualPiece (d + 1) where
  toFun f := ⟨formMultiplication K (c + m) d (fun j => (f j).val), by
    constructor
    · exact (representativeMultiplication K C.point d (fun j =>
        ⟨(f j).val, (f j).property.1⟩)).property
    · change coneRestrictForm K c m (d + 1) _ = 0
      rw [coneRestrictForm_multiplication]
      have hzero : (fun j : Fin m => coneRestrictForm K c m d (f (j.natAdd c)).val) = 0 := by
        funext j
        exact (f (j.natAdd c)).property.2
      rw [hzero, map_zero]⟩
  map_add' f g := by
    apply Subtype.ext
    exact (formMultiplication K (c + m) d).map_add _ _
  map_smul' a f := by
    apply Subtype.ext
    exact (formMultiplication K (c + m) d).map_smul a _

/-- The coefficient tuple of the normal multiples of lifted trace equations. -/
def normalTraceCoefficients (d : ℕ) (f : Fin c → C.tracePiece d) :
    Fin (c + m) → Forms K (c + m) d :=
  Fin.addCases (fun j => coneExtendForm K c m d (f j).val) (fun _ => 0)

/-- Multiplication of lifted trace equations by the normal coordinates. -/
def normalTraceMultiplication (d : ℕ) :
    (Fin c → C.tracePiece d) →ₗ[K] C.residualPiece (d + 1) where
  toFun f := ⟨formMultiplication K (c + m) d (C.normalTraceCoefficients d f), by
    constructor
    · have hf : ∀ j, C.normalTraceCoefficients d f j ∈ C.conePiece d := by
        intro j
        refine Fin.addCases (fun i => ?_) (fun i => ?_) j
        · simpa [normalTraceCoefficients] using C.extend_vanishes_cone (f i).val (f i).property
        · simp [normalTraceCoefficients]
      exact (representativeMultiplication K C.point d (fun j =>
        ⟨C.normalTraceCoefficients d f j, hf j⟩)).property
    · change coneRestrictForm K c m (d + 1) _ = 0
      rw [coneRestrictForm_multiplication]
      have hzero : (fun j : Fin m => coneRestrictForm K c m d
          (C.normalTraceCoefficients d f (j.natAdd c))) = 0 := by
        funext j
        simp [normalTraceCoefficients]
      rw [hzero, map_zero]⟩
  map_add' f g := by
    apply Subtype.ext
    change formMultiplication K (c + m) d _ =
      formMultiplication K (c + m) d _ + formMultiplication K (c + m) d _
    rw [← map_add]
    congr 1
    funext j
    refine Fin.addCases (fun i => ?_) (fun i => ?_) j <;> simp [normalTraceCoefficients]
  map_smul' a f := by
    apply Subtype.ext
    change formMultiplication K (c + m) d _ = a • formMultiplication K (c + m) d _
    rw [← map_smul]
    congr 1
    funext j
    refine Fin.addCases (fun i => ?_) (fun i => ?_) j <;> simp [normalTraceCoefficients]

/-- The middle map of the cone construction, in coordinate tensor notation. -/
def middleMultiplication (d : ℕ) :
    ((Fin (c + m) → C.residualPiece d) × (Fin c → C.tracePiece d)) →ₗ[K]
      C.residualPiece (d + 1) :=
  (C.residualMultiplication d).comp (LinearMap.fst K _ _) +
    (C.normalTraceMultiplication d).comp (LinearMap.snd K _ _)

@[simp] theorem middleMultiplication_val (d : ℕ)
    (f : (Fin (c + m) → C.residualPiece d) × (Fin c → C.tracePiece d)) :
    (C.middleMultiplication d f).val =
      formMultiplication K (c + m) d (fun j => (f.1 j).val) +
        formMultiplication K (c + m) d (C.normalTraceCoefficients d f.2) := rfl

/-- Split each equation and group the trace coefficients according to whether
its multiplier is a trace coordinate or a normal coordinate. -/
def sourceSplit (d : ℕ) :
    (Fin (c + m) → C.unionPiece d) ≃ₗ[K]
      (Fin m → C.tracePiece d) ×
        ((Fin (c + m) → C.residualPiece d) × (Fin c → C.tracePiece d)) :=
  coordinateSplitEquiv (K := K) (A := C.unionPiece d) (B := C.tracePiece d)
    (C := C.residualPiece d) (C.split d) c m

@[simp] theorem sourceSplit_symm_normal (d : ℕ)
    (x : (Fin m → C.tracePiece d) ×
      ((Fin (c + m) → C.residualPiece d) × (Fin c → C.tracePiece d))) (i : Fin c) :
    (((C.sourceSplit d).symm x) (i.castAdd m)).val =
      coneExtendForm K c m d (x.2.2 i).val + (x.2.1 (i.castAdd m)).val := by
  simp [sourceSplit, coordinateSplitEquiv_symm_apply, split_symm_val]

@[simp] theorem sourceSplit_symm_trace (d : ℕ)
    (x : (Fin m → C.tracePiece d) ×
      ((Fin (c + m) → C.residualPiece d) × (Fin c → C.tracePiece d))) (i : Fin m) :
    (((C.sourceSplit d).symm x) (i.natAdd c)).val =
      coneExtendForm K c m d (x.1 i).val + (x.2.1 (i.natAdd c)).val := by
  simp [sourceSplit, coordinateSplitEquiv_symm_apply, split_symm_val]

/-- Polynomial multiplication respects the two cone summands after regrouping
its source into trace and middle coefficients. -/
theorem multiplication_sourceSplit (d : ℕ)
    (x : (Fin m → C.tracePiece d) ×
      ((Fin (c + m) → C.residualPiece d) × (Fin c → C.tracePiece d))) :
    (C.multiplication d ((C.sourceSplit d).symm x)).val =
      coneExtendForm K c m (d + 1) (C.traceMultiplication d x.1).val +
        (C.middleMultiplication d x.2).val := by
  have rearrange (a b u v : Poly K (c + m)) :
      (a + b) + (u + v) = u + ((b + v) + a) := by abel
  apply Subtype.ext
  change (∑ i : Fin (c + m), X i * (((C.sourceSplit d).symm x i).val.val)) =
    coneExtend K c m (∑ j : Fin m, X j * (x.1 j).val.val) +
      ((∑ i : Fin (c + m), X i * (x.2.1 i).val.val) +
        ∑ i : Fin (c + m), X i * (C.normalTraceCoefficients d x.2.2 i).val)
  simp only [Fin.sum_univ_add, sourceSplit_symm_normal, sourceSplit_symm_trace,
    map_sum, map_mul, coneExtend_X, normalTraceCoefficients, Fin.addCases_left,
    Fin.addCases_right, Submodule.coe_add, coneExtendForm, Submodule.coe_zero, mul_add, mul_zero, Finset.sum_const_zero,
    Finset.sum_add_distrib, add_zero]
  exact rearrange _ _ _ _

/-- In canonical cone coordinates the actual multiplication map is block
diagonal, with ordinary trace multiplication and the middle map. -/
theorem multiplication_block (d : ℕ)
    (x : (Fin m → C.tracePiece d) ×
      ((Fin (c + m) → C.residualPiece d) × (Fin c → C.tracePiece d))) :
    C.split (d + 1) (C.multiplication d ((C.sourceSplit d).symm x)) =
      (C.traceMultiplication d x.1, C.middleMultiplication d x.2) := by
  apply (C.split (d + 1)).symm.injective
  rw [LinearEquiv.symm_apply_apply]
  apply Subtype.ext
  rw [split_symm_val]
  exact C.multiplication_sourceSplit d x

/-- Equality of linear maps exhibiting the direct sum in Appendix A.1. -/
theorem multiplication_block_linearMap (d : ℕ) :
    (C.split (d + 1)).toLinearMap.comp
      ((C.multiplication d).comp (C.sourceSplit d).symm.toLinearMap) =
        (C.traceMultiplication d).prodMap (C.middleMultiplication d) := by
  apply LinearMap.ext
  intro x
  exact C.multiplication_block d x

/-- Injectivity of cone multiplication is equivalent to injectivity of both
actual polynomial blocks. -/
theorem multiplication_injective_iff (d : ℕ) :
    Function.Injective (C.multiplication d) ↔
      Function.Injective (C.traceMultiplication d) ∧
        Function.Injective (C.middleMultiplication d) := by
  have hblocks : Function.Injective ((C.traceMultiplication d).prodMap
      (C.middleMultiplication d)) ↔ Function.Injective (C.traceMultiplication d) ∧
        Function.Injective (C.middleMultiplication d) :=
    linearMap_prodMap_injective_iff (K := K)
      (V := Fin m → C.tracePiece d) (W := C.tracePiece (d + 1))
      (U := (Fin (c + m) → C.residualPiece d) × (Fin c → C.tracePiece d))
      (Z := C.residualPiece (d + 1)) (C.traceMultiplication d) (C.middleMultiplication d)
  constructor
  · intro hm
    apply hblocks.mp
    intro x y hxy
    apply (C.sourceSplit d).symm.injective
    apply hm
    apply (C.split (d + 1)).injective
    simpa only [C.multiplication_block, LinearMap.prodMap_apply] using hxy
  · intro h x y hxy
    apply (C.sourceSplit d).injective
    apply hblocks.mpr h
    have hh := congrArg (C.split (d + 1)) hxy
    have hx := C.multiplication_block d (C.sourceSplit d x)
    have hy := C.multiplication_block d (C.sourceSplit d y)
    simp only [LinearEquiv.symm_apply_apply] at hx hy
    rw [hx, hy] at hh
    exact hh

/-- Surjectivity of cone multiplication is equivalent to surjectivity of both
actual polynomial blocks. -/
theorem multiplication_surjective_iff (d : ℕ) :
    Function.Surjective (C.multiplication d) ↔
      Function.Surjective (C.traceMultiplication d) ∧
        Function.Surjective (C.middleMultiplication d) := by
  have hblocks : Function.Surjective ((C.traceMultiplication d).prodMap
      (C.middleMultiplication d)) ↔ Function.Surjective (C.traceMultiplication d) ∧
        Function.Surjective (C.middleMultiplication d) :=
    linearMap_prodMap_surjective_iff (K := K)
      (V := Fin m → C.tracePiece d) (W := C.tracePiece (d + 1))
      (U := (Fin (c + m) → C.residualPiece d) × (Fin c → C.tracePiece d))
      (Z := C.residualPiece (d + 1)) (C.traceMultiplication d) (C.middleMultiplication d)
  constructor
  · intro hm
    apply hblocks.mp
    intro y
    obtain ⟨x, hx⟩ := hm ((C.split (d + 1)).symm y)
    refine ⟨C.sourceSplit d x, ?_⟩
    have hh := C.multiplication_block d (C.sourceSplit d x)
    simp only [LinearEquiv.symm_apply_apply] at hh
    rw [hx, LinearEquiv.apply_symm_apply] at hh
    exact hh.symm
  · intro h y
    obtain ⟨x, hx⟩ := hblocks.mpr h (C.split (d + 1) y)
    refine ⟨(C.sourceSplit d).symm x, ?_⟩
    apply (C.split (d + 1)).injective
    rw [C.multiplication_block]
    exact hx

/-- When trace multiplication is an isomorphism, maximal rank reduces exactly
to the middle map in the cone construction. -/
theorem multiplication_maximalRank_iff (d : ℕ)
    (htrace : Function.Bijective (C.traceMultiplication d)) :
    HasMaximalRank (C.multiplication d) ↔ HasMaximalRank (C.middleMultiplication d) := by
  change (Function.Injective (C.multiplication d) ∨ Function.Surjective (C.multiplication d)) ↔ _
  rw [C.multiplication_injective_iff, C.multiplication_surjective_iff]
  simp only [htrace.1, htrace.2, true_and]
  rfl

end ConeConfiguration
