def support (i : Fin 75) : Fin 90 := Fin.ofNat 90 supportData[i.val]!

def traceCoordinate (i : Fin 90) (j : Fin 8) : ℕ :=
  traceCoordinatesData[i.val * 8 + j.val]!

def normalCoordinate (i : Fin 75) (j : Fin 2) : ℕ :=
  if j = 0 then 1 else normalSlopesData[i.val]!

def height (i : Fin 75) : ℕ := heightsData[i.val]!

/-- The same marked cone parameters over any coefficient semiring. -/
def parameters (R : Type*) [Semiring R] : Parameters R 2 8 75 90 :=
  assemble (fun ij => traceCoordinate ij.1 ij.2)
    (fun ij => normalCoordinate ij.1 ij.2) (fun i => height i)

def pointCoordinate (i : Fin 75) (j : Fin 10) : ℕ :=
  Fin.addCases (normalCoordinate i) (fun k => height i * traceCoordinate (support i) k) j

def exponentDigit {n : ℕ} (code : ℕ) (j : Fin n) : ℕ := code / 5 ^ j.val % 5

def exponent {n : ℕ} (code : ℕ) : Fin n →₀ ℕ :=
  Finsupp.onFinset Finset.univ (exponentDigit code) (fun _ _ => Finset.mem_univ _)

@[simp] theorem exponent_apply {n : ℕ} (code : ℕ) (j : Fin n) :
    exponent code j = exponentDigit code j := rfl

def normalExponent (i : Fin 100) : Fin 10 →₀ ℕ :=
  exponent normalExponentCodes[i.val]!

def traceExponent (i : Fin 120) : Fin 8 →₀ ℕ :=
  exponent traceExponentCodes[i.val]!

def quarticExponent (i : Fin 310) : Fin 10 →₀ ℕ :=
  exponent quarticExponentCodes[i.val]!

def normalLookup (i : Fin 310) (j : Fin 10) : Option (Fin 100) :=
  let a := tableGet 9 normalLookupTable i.val / 128 ^ j.val % 128
  if h : a < 100 then some ⟨a, h⟩ else none

def traceLookup (i : Fin 310) (j : Fin 2) : Option (Fin 120) :=
  let a := tableGet 9 traceLookupTable i.val / 128 ^ j.val % 128
  if h : a < 120 then some ⟨a, h⟩ else none

def middlePermutationEntry (j : Fin 310) : ℕ :=
  tableGet 9 middlePermutationTable j.val

end IdealGeneration.CubicTen
