/-- The numerical cubic evaluation matrix. -/
def EP : Matrix (Fin 75) (Fin 100) (ZMod modulus) :=
  fun i j => residueMatrix modulus normalKernelTables.lower (Fin.castLE (by decide) i) j

/-- The numerical basis matrix with monomial rows and basis columns. -/
def Kn : Matrix (Fin 100) (Fin 25) (ZMod modulus) :=
  fun i j => residueMatrix modulus normalKernelTables.upper i (Fin.castLE (by decide) j)

/-- Sparse natural residues in one numerical evaluation row. -/
def EPRow (i : Fin 75) : SparseRow 100 ℕ := normalKernelTables.lower (Fin.castLE (by decide) i)

/-- Sparse natural residues in one numerical basis row, padded by zeros. -/
def KnRow (i : Fin 100) : SparseRow 100 ℕ := normalKernelTables.upper i

theorem EP_apply (i : Fin 75) (j : Fin 100) :
    EP i j = ((rowValue (EPRow i) j : ℕ) : ZMod modulus) := rfl

theorem Kn_apply (i : Fin 100) (j : Fin 25) :
    Kn i j = ((rowValue (KnRow i) (Fin.castLE (by decide : 25 ≤ 100) j) : ℕ) : ZMod modulus) := rfl

private theorem normalKernel_padded_zero :
    residueMatrix modulus normalKernelTables.lower * residueMatrix modulus normalKernelTables.upper = 0 := by
  rw [normalKernelTables.checked_product (by decide) normalKernelValid]
  ext i j
  rfl

/-- The proposed basis columns satisfy the numerical evaluation constraints. -/
theorem normal_annihilation : EP * Kn = 0 := by
  ext i j
  have h := congrFun (congrFun normalKernel_padded_zero (Fin.castLE (by decide) i))
    (Fin.castLE (by decide) j)
  simpa only [EP, Kn, Matrix.mul_apply, Matrix.zero_apply] using h

