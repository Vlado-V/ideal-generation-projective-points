/-- The free coordinates of the proposed basis form an identity matrix. -/
theorem normal_free_identity : Kn.submatrix normalFreeRow id = 1 := by
  ext i j
  change ((rowValue (normalKernelTables.upper (normalFreeRow i))
    (Fin.castLE (by decide) j) : ℕ) : ZMod modulus) =
    (1 : Matrix (Fin 25) (Fin 25) (ZMod modulus)) i j
  rw [normalFreeIdentity]
  have he : (Fin.castLE (by decide : 25 ≤ 100) i = Fin.castLE (by decide) j) ↔ i = j := by
    constructor
    · intro h
      exact Fin.ext (congrArg (fun k : Fin 100 => k.val) h)
    · intro h
      subst j
      rfl
  by_cases hij : i = j <;> simp [rowValue, Matrix.one_apply, he, hij]

