private def decodeSparse : Nat → Nat → SparseRow 288 Nat
  | 0, _ => []
  | n + 1, code =>
    let digit := code % (2 ^ 19)
    (⟨(digit / 1024) % 288, Nat.mod_lt _ (by decide)⟩, digit % 1024) ::
      decodeSparse n (code / (2 ^ 19))

private theorem decodeSparse_length (n code : Nat) : (decodeSparse n code).length = n := by
  induction n generalizing code with
  | zero => rfl
  | succ n ih => simp [decodeSparse, ih]

private theorem decodeSparse_coeff (n code : Nat) (e : Fin 288 × Nat)
    (he : e ∈ decodeSparse n code) : e.2 < 1024 := by
  induction n generalizing code with
  | zero => simp [decodeSparse] at he
  | succ n ih =>
      simp only [decodeSparse, List.mem_cons] at he
      rcases he with h | h
      · rw [h]
        exact Nat.mod_lt _ (by decide)
      · exact ih _ h

def lowerRows (i : Fin 288) : SparseRow 288 Nat :=
  decodeSparse (min lowerLengths[i.val]! 288) lowerCodes[i.val]!

def upperRows (i : Fin 288) : SparseRow 288 Nat :=
  decodeSparse (min upperLengths[i.val]! 288) upperCodes[i.val]!

theorem lowerRows_length_le (i : Fin 288) : (lowerRows i).length ≤ 288 := by
  rw [lowerRows, decodeSparse_length]
  exact min_le_right _ _

theorem upperRows_length_le (i : Fin 288) : (upperRows i).length ≤ 288 := by
  rw [upperRows, decodeSparse_length]
  exact min_le_right _ _

theorem lowerRows_coeff_lt (i : Fin 288) (e : Fin 288 × Nat) (he : e ∈ lowerRows i) :
    e.2 < 1024 := decodeSparse_coeff _ _ e he

theorem upperRows_coeff_lt (i : Fin 288) (e : Fin 288 × Nat) (he : e ∈ upperRows i) :
    e.2 < 1024 := decodeSparse_coeff _ _ e he

def packedUpper (i : Fin 288) : Nat := upperPackedCodes[i.val]!

private def decodeQuotients : Nat → Nat → List Nat
  | 0, _ => []
  | n + 1, code => code % (2 ^ 19) :: decodeQuotients n (code / (2 ^ 19))

private theorem decodeQuotients_length (n code : Nat) : (decodeQuotients n code).length = n := by
  induction n generalizing code with
  | zero => rfl
  | succ n ih => simp [decodeQuotients, ih]

private theorem decodeQuotients_lt (n code : Nat) :
    ((decodeQuotients n code).all fun q => decide (q < 2 ^ 19)) = true := by
  induction n generalizing code with
  | zero => rfl
  | succ n ih =>
      simp only [decodeQuotients, List.all_cons, ih, Bool.and_true, decide_eq_true_eq]
      exact Nat.mod_lt _ (by decide)

def quotientRows (i : Fin 288) : List Nat := decodeQuotients 288 quotientCodes[i.val]!

theorem quotientRows_length (i : Fin 288) : (quotientRows i).length = 288 :=
  decodeQuotients_length _ _

theorem quotientRows_lt (i : Fin 288) :
    ((quotientRows i).all fun q => decide (q < 2 ^ 19)) = true :=
  decodeQuotients_lt _ _

private def indexAt (a : Array Nat) (i : Fin 288) : Fin 288 :=
  ⟨a[i.val]! % 288, Nat.mod_lt _ (by decide)⟩

def rowPermutation : Fin 288 → Fin 288 := indexAt rowPermutationValues

def columnPermutation : Fin 288 → Fin 288 := indexAt columnPermutationValues

def rowInverse : Fin 288 → Fin 288 := indexAt rowInverseValues

def columnInverse : Fin 288 → Fin 288 := indexAt columnInverseValues

def rowEquiv : Fin 288 ≃ Fin 288 where
  toFun := rowPermutation
  invFun := rowInverse
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def columnEquiv : Fin 288 ≃ Fin 288 where
  toFun := columnPermutation
  invFun := columnInverse
  left_inv := by decide +kernel
  right_inv := by decide +kernel

end IdealGeneration.TripleNormalInitial.CubicLU
