module

public import IdealGeneration.Homogeneous
public import Mathlib.LinearAlgebra.Dual.Lemmas
public import Mathlib.Algebra.MvPolynomial.Funext

@[expose] public section

set_option backward.privateInPublic true
set_option backward.privateInPublic.warn false
set_option backward.proofsInPublic true


/-!
Actual homogeneous ideals of points in the standard affine chart.
The arguments generalize `ChoppedPlane/Points.lean` from the author's prior
Apache-2.0 development from three variables to any positive number of variables.
-/

noncomputable section
namespace IdealGeneration
open MvPolynomial Module

variable (K : Type*) [Field K]

/-- Ordered affine coordinates for points of projective `n`-space. -/
abbrev PointCoordinates (n p : ℕ) := Fin p × Fin n → K

/-- Normalize the final projective coordinate to one. -/
def chartPoint {n p : ℕ} (a : PointCoordinates K n p) (i : Fin p) : Fin (n + 1) → K :=
  Fin.snoc (fun j => a (i, j)) 1

/-- Distinct affine coordinates give distinct normalized projective points. -/
def DistinctPoints {n p : ℕ} (a : PointCoordinates K n p) : Prop :=
  Function.Injective (fun i => fun j => a (i, j))

/-- The homogeneous ideal generated by the equations of one chart point. -/
def singlePointIdeal {n : ℕ} (u : Fin n → K) : Ideal (Poly K (n + 1)) :=
  Ideal.span (Set.range (fun j : Fin n => X j.castSucc - C (u j) * X (Fin.last n)))

/-- The vanishing ideal of the ordered configuration. -/
def pointIdeal {n p : ℕ} (a : PointCoordinates K n p) : Ideal (Poly K (n + 1)) :=
  ⨅ i : Fin p, singlePointIdeal K (fun j => a (i, j))

/-- Evaluation of homogeneous forms at the normalized point representatives. -/
def pointEvaluation {n p : ℕ} (a : PointCoordinates K n p) (d : ℕ) :
    Forms K (n + 1) d →ₗ[K] (Fin p → K) :=
  LinearMap.pi (fun i => evaluationLinear K (n + 1) d (chartPoint K a i))

def pointDegreePiece {n p : ℕ} (a : PointCoordinates K n p) (d : ℕ) :
    Submodule K (Forms K (n + 1) d) := LinearMap.ker (pointEvaluation K a d)

/-- The Hilbert function is the quotient dimension of the actual evaluation kernel. -/
def pointHilbertFunction {n p : ℕ} (a : PointCoordinates K n p) (d : ℕ) : ℕ :=
  finrank K ((Forms K (n + 1) d) ⧸ pointDegreePiece K a d)

variable {K}

@[simp] theorem chartPoint_castSucc {n p : ℕ} (a : PointCoordinates K n p)
    (i : Fin p) (j : Fin n) : chartPoint K a i j.castSucc = a (i, j) := by
  simp [chartPoint]

@[simp] theorem chartPoint_last {n p : ℕ} (a : PointCoordinates K n p)
    (i : Fin p) : chartPoint K a i (Fin.last n) = 1 := by
  simp [chartPoint]

@[simp] theorem pointEvaluation_apply {n p d : ℕ} (a : PointCoordinates K n p)
    (f : Forms K (n + 1) d) (i : Fin p) :
    pointEvaluation K a d f i = eval (chartPoint K a i) f.val := rfl

@[simp] theorem mem_pointDegreePiece {n p d : ℕ} (a : PointCoordinates K n p)
    (f : Forms K (n + 1) d) :
    f ∈ pointDegreePiece K a d ↔ ∀ i, eval (chartPoint K a i) f.val = 0 := by
  simp [pointDegreePiece, LinearMap.mem_ker, funext_iff]

theorem pointHilbertFunction_eq_rank {n p d : ℕ} (a : PointCoordinates K n p) :
    pointHilbertFunction K a d = finrank K (pointEvaluation K a d).range :=
  (pointEvaluation K a d).quotKerEquivRange.finrank_eq

theorem finrank_chart_forms (n d : ℕ) :
    finrank K (Forms K (n + 1) d) = (n + d).choose d := by
  rw [finrank_forms]
  congr 1
  omega

theorem pointHilbertFunction_le {n p d : ℕ} (a : PointCoordinates K n p) :
    pointHilbertFunction K a d ≤ min ((n + d).choose d) p := by
  rw [pointHilbertFunction_eq_rank]
  apply le_min
  · simpa [finrank_chart_forms] using (pointEvaluation K a d).finrank_range_le
  · simpa using Submodule.finrank_le (pointEvaluation K a d).range

/-- Substitution modulo the point equations. -/
theorem sub_substitution_mem {n : ℕ} (I : Ideal (Poly K n)) (q : Fin n → Poly K n)
    (hq : ∀ i, X i - q i ∈ I) (f : Poly K n) : f - eval₂ C q f ∈ I := by
  let π := Ideal.Quotient.mk I
  have heq : π.comp (eval₂Hom C q) = π := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [π]
    · intro i
      rw [RingHom.comp_apply, eval₂Hom_X']
      exact (Ideal.Quotient.eq.mpr (hq i)).symm
  apply Ideal.Quotient.eq.mp
  exact (congrArg (fun h : Poly K n →+* Poly K n ⧸ I => h f) heq).symm

theorem homogeneous_mem_singlePointIdeal_iff {n d : ℕ} (u : Fin n → K)
    (f : Forms K (n + 1) d) :
    f.val ∈ singlePointIdeal K u ↔ eval (Fin.snoc u 1) f.val = 0 := by
  classical
  let I := singlePointIdeal K u
  let v : Fin (n + 1) → K := Fin.snoc u 1
  let q : Fin (n + 1) → Poly K (n + 1) := fun i => X (Fin.last n) * C (v i)
  have hq : ∀ i, X i - q i ∈ I := by
    intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simp [q, v]
    · apply Ideal.subset_span
      exact ⟨j, by simp [q, v, mul_comm]⟩
  have hs : eval₂ C q f.val = X (Fin.last n) ^ d * C (eval v f.val) := by
    rw [homogeneous_eval₂_scale f.property C (fun i => C (v i)) (X (Fin.last n))]
    congr 1
    simpa [Function.comp_def] using
      (MvPolynomial.eval₂_comp_left C (RingHom.id K) v f.val).symm
  constructor
  · intro hf
    have hle : I ≤ RingHom.ker (eval v) := by
      apply Ideal.span_le.mpr
      rintro g ⟨j, rfl⟩
      simp [v]
    exact hle hf
  · intro hf
    have hz : eval₂ C q f.val = 0 := by simpa [hf, v] using hs
    have hh := sub_substitution_mem I q hq f.val
    simpa [hz, I] using hh

/-- The kernel description agrees with the actual homogeneous point ideal. -/
theorem homogeneous_mem_pointIdeal_iff {n p d : ℕ} (a : PointCoordinates K n p)
    (f : Forms K (n + 1) d) :
    f.val ∈ pointIdeal K a ↔ f ∈ pointDegreePiece K a d := by
  simp only [pointIdeal, Ideal.mem_iInf, mem_pointDegreePiece]
  apply forall_congr'
  intro i
  exact homogeneous_mem_singlePointIdeal_iff _ f

/-- Chart evaluations detect every homogeneous polynomial over an infinite field. -/
theorem homogeneous_eq_zero_of_chart_evaluations [Infinite K] {n d : ℕ}
    (f : Forms K (n + 1) d) (h : ∀ u : Fin n → K, eval (Fin.snoc u 1) f.val = 0) :
    f = 0 := by
  have hz : (X (Fin.last n) : Poly K (n + 1)) * f.val = 0 := by
    apply MvPolynomial.funext
    intro v
    simp only [map_mul, eval_X, map_zero]
    by_cases hv : v (Fin.last n) = 0
    · simp [hv]
    · have he : (fun i : Fin (n + 1) => v (Fin.last n) *
          (Fin.snoc (fun j : Fin n => v j.castSucc / v (Fin.last n)) 1 : Fin (n + 1) → K) i) = v := by
        funext i
        refine Fin.lastCases ?_ (fun j => ?_) i <;> simp [mul_div_cancel₀ _ hv]
      have hs := homogeneous_eval_scale f.property
        (Fin.snoc (fun j : Fin n => v j.castSucc / v (Fin.last n)) 1) (v (Fin.last n))
      rw [he, h] at hs
      simp [hs]
  exact Subtype.ext ((mul_eq_zero.mp hz).resolve_left (MvPolynomial.X_ne_zero (Fin.last n)))

theorem chart_evaluations_span_dual [Infinite K] (n d : ℕ) :
    Submodule.span K (Set.range (fun u : Fin n → K =>
      evaluationLinear K (n + 1) d (Fin.snoc u 1))) = ⊤ := by
  apply Submodule.span_eq_top_of_ne_zero
  intro f hf
  by_contra! h
  exact hf (homogeneous_eq_zero_of_chart_evaluations f (fun u =>
    h (evaluationLinear K (n + 1) d (Fin.snoc u 1)) ⟨u, rfl⟩))

theorem exists_independent_chart_evaluations [Infinite K] (n d q : ℕ)
    (hq : q ≤ (n + d).choose d) :
    ∃ u : Fin q → Fin n → K,
      LinearIndependent K (fun i => evaluationLinear K (n + 1) d (Fin.snoc (u i) 1)) := by
  classical
  induction q with
  | zero => exact ⟨Fin.elim0, linearIndependent_empty_type⟩
  | succ q ih =>
      obtain ⟨u, hu⟩ := ih (by omega)
      let W := Submodule.span K (Set.range (fun i =>
        evaluationLinear K (n + 1) d (Fin.snoc (u i) 1)))
      have hW : finrank K W = q := by simp [W, finrank_span_eq_card hu]
      have hproper : W ≠ ⊤ := by
        intro heq
        have ht : finrank K W = (n + d).choose d := by
          rw [heq, finrank_top, Subspace.dual_finrank_eq, finrank_chart_forms]
        omega
      have hex : ∃ v : Fin n → K, evaluationLinear K (n + 1) d (Fin.snoc v 1) ∉ W := by
        by_contra! h
        have hle : Submodule.span K (Set.range (fun v : Fin n → K =>
            evaluationLinear K (n + 1) d (Fin.snoc v 1))) ≤ W := by
          apply Submodule.span_le.mpr
          rintro _ ⟨v, rfl⟩
          exact h v
        rw [chart_evaluations_span_dual n d] at hle
        exact hproper (top_le_iff.mp hle)
      obtain ⟨v, hv⟩ := hex
      refine ⟨Fin.snoc u v, ?_⟩
      have heq : (fun i : Fin (q + 1) =>
          evaluationLinear K (n + 1) d (Fin.snoc ((Fin.snoc u v : Fin (q + 1) → Fin n → K) i) 1)) =
          Fin.snoc (fun i => evaluationLinear K (n + 1) d (Fin.snoc (u i) 1))
            (evaluationLinear K (n + 1) d (Fin.snoc v 1)) := by
        funext i
        refine Fin.lastCases ?_ (fun j => ?_) i <;> simp
      rw [heq]
      exact linearIndependent_finSnoc.mpr ⟨hu, hv⟩

/-- Scalar interpolation has maximal rank for some actual point configuration. -/
theorem exists_pointHilbertFunction_maximal [Infinite K] (n p d : ℕ) :
    ∃ a : PointCoordinates K n p,
      pointHilbertFunction K a d = min ((n + d).choose d) p := by
  classical
  let q := min ((n + d).choose d) p
  obtain ⟨u, hu⟩ := exists_independent_chart_evaluations (K := K) n d q (min_le_left _ _)
  let a : PointCoordinates K n p := fun ij =>
    if h : ij.1.val < q then u ⟨ij.1.val, h⟩ ij.2 else 0
  refine ⟨a, le_antisymm (pointHilbertFunction_le a) ?_⟩
  rw [pointHilbertFunction_eq_rank, ← LinearMap.finrank_range_dualMap_eq_finrank_range]
  have hle : Submodule.span K (Set.range (fun i =>
      evaluationLinear K (n + 1) d (Fin.snoc (u i) 1))) ≤
      (pointEvaluation K a d).dualMap.range := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    refine ⟨LinearMap.proj (Fin.castLE (min_le_right _ _) i), ?_⟩
    apply LinearMap.ext
    intro f
    have ha : chartPoint K a (Fin.castLE (min_le_right _ _) i) = Fin.snoc (u i) 1 := by
      funext j
      refine Fin.lastCases ?_ (fun l => ?_) j <;> simp [chartPoint, a, i.isLt]
    simp [LinearMap.dualMap_apply, pointEvaluation, evaluationLinear, ha]
  have hdim := Submodule.finrank_mono hle
  simpa only [finrank_span_eq_card hu, Fintype.card_fin] using hdim

end IdealGeneration
