private def readSlot {n : Nat} [NeZero n] (code i : Nat) : Option (Fin n) :=
  let digit := code / (128 ^ i) % 128
  if digit = 0 then none else some ⟨(digit - 1) % n, Nat.mod_lt _ (NeZero.pos n)⟩

def normalSlot (i : Fin 288) (j : Fin 15) : Option NormalIndex :=
  (readSlot (n := 42) normalSlotCodes[i.val]! j.val).map
    (finSumFinEquiv : NormalIndex ≃ Fin 42).symm

def traceSlot (i : Fin 288) (j : Fin 3) : Option TraceIndex :=
  (readSlot (n := 78) traceSlotCodes[i.val]! j.val).map
    (finSumFinEquiv : TraceIndex ≃ Fin 78).symm

def normalSlotLookup (i : Fin 288) (j : Fin 15) : Option NormalIndex :=
  (dropMultiplier j (cubicPivotTuple i)).bind (fun t =>
    normalIndices.find? (fun a => decide (normalPair a = t)))

def traceSlotLookup (i : Fin 288) (j : Fin 3) : Option TraceIndex :=
  (dropMultiplier (j.castAdd 12) (cubicPivotTuple i)).bind (fun t =>
    traceIndices.find? (fun a => decide (tracePair a = t)))

theorem normalSlot_correct : ∀ i j, normalSlot i j = normalSlotLookup i j := by
  decide +kernel

theorem traceSlot_correct : ∀ i j, traceSlot i j = traceSlotLookup i j := by
  decide +kernel

/-- A direct checked coefficient lookup for the cubic matrix. -/
def slotMiddleMod : Matrix (Fin 288) CubicColumn ModField :=
  fun i => Sum.elim
    (fun j => (normalSlot i j.1).elim 0 (fun a => normalKernelMod a j.2))
    (fun j => (traceSlot i j.1).elim 0 (fun a => traceKernelMod a j.2))

theorem slotMiddleMod_eq_fast : slotMiddleMod = fastMiddleMod := by
  ext i col
  cases col with
  | inl j =>
      change (normalSlot i j.1).elim 0 (fun a => normalKernelMod a j.2) =
        lookupCoefficient normalIndices normalPair (fun a => normalKernelMod a j.2)
          (dropMultiplier j.1 (cubicPivotTuple i))
      rw [normalSlot_correct]
      unfold normalSlotLookup lookupCoefficient
      cases dropMultiplier j.1 (cubicPivotTuple i) <;> rfl
  | inr j =>
      change (traceSlot i j.1).elim 0 (fun a => traceKernelMod a j.2) =
        lookupCoefficient traceIndices tracePair (fun a => traceKernelMod a j.2)
          (dropMultiplier (j.1.castAdd 12) (cubicPivotTuple i))
      rw [traceSlot_correct]
      unfold traceSlotLookup lookupCoefficient
      cases dropMultiplier (j.1.castAdd 12) (cubicPivotTuple i) <;> rfl

