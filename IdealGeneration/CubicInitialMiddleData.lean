private def decodeLookup (n value : ℕ) [NeZero n] : Option (Fin n) :=
  if value = 0 then none else some (Fin.ofNat n (value - 1))

def normalLookup (i : Fin 650) (j : Fin 12) : Option (Fin 144) :=
  decodeLookup 144 (normalLookupData[i.val]! / 256 ^ j.val % 256)

def traceLookup (i : Fin 650) (j : Fin 2) : Option (Fin 220) :=
  decodeLookup 220 (traceLookupData[i.val]! / 256 ^ j.val % 256)

/-- Multiplier-first column ordering from Appendix C.2. -/
def columnChart : MiddleColumn 2 10 (Fin 36) (Fin 55) ≃ Fin 542 :=
  (Equiv.sumCongr finProdFinEquiv finProdFinEquiv).trans finSumFinEquiv

def rawMiddleEntry (i : Fin 650) (j : Fin 542) : ℕ :=
  Sum.elim
    (fun a : Fin 12 × Fin 36 => ((normalLookup i a.1).map fun k => normalKernelEntry k a.2).getD 0)
    (fun a : Fin 2 × Fin 55 => ((traceLookup i a.1).map fun k => traceKernelEntry k a.2).getD 0)
    (columnChart.symm j)

def rawMiddleRow (i : Fin 650) : SparseRow 542 ℕ :=
  (List.ofFn fun j => (j, rawMiddleEntry i j)).filter fun e => e.2 != 0

