module

public import Mathlib.Data.Nat.Choose.Basic
public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.LinearAlgebra.Dimension.Finrank
public import Mathlib.LinearAlgebra.Projectivization.Basic
public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.LinearAlgebra.TensorProduct.Basic
public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.RingTheory.MvPolynomial.Homogeneous

@[expose] public section

/-! # Ideal generation for general reduced projective points

Theorem 1.1 on the ordered configuration space of the standard affine chart.
One nonempty principal open gives distinct projective points, a radical
vanishing ideal, the Hilbert function, maximal rank of the tensor multiplication,
and the two counts of minimal homogeneous generators.
-/

noncomputable section

namespace PalomarModel.IdealGeneration

open Module MvPolynomial
open scoped TensorProduct

/-- The number of degree-`d` monomials in `n` variables. -/
def N (n d : ℕ) : ℕ := (n + d - 1).choose d

/-- The critical degree-`d` ideal dimension. -/
def E (n d : ℕ) : ℚ := (N n d : ℚ) / (d + 1)

variable (K : Type*) [Field K]

abbrev Poly (n : ℕ) := MvPolynomial (Fin n) K

abbrev Forms (n d : ℕ) := MvPolynomial.homogeneousSubmodule (Fin n) K d

/-- Ordered affine coordinates for points of projective `n`-space. -/
abbrev PointCoordinates (n p : ℕ) := Fin p × Fin n → K

/-- Normalize the final projective coordinate to one. -/
def chartPoint {n p : ℕ} (a : PointCoordinates K n p) (i : Fin p) : Fin (n + 1) → K :=
  Fin.snoc (fun j => a (i, j)) 1

/-- The homogeneous ideal generated by the equations of one chart point. -/
def singlePointIdeal {n : ℕ} (u : Fin n → K) : Ideal (Poly K (n + 1)) :=
  Ideal.span (Set.range (fun j : Fin n => X j.castSucc - C (u j) * X (Fin.last n)))

/-- The vanishing ideal of the ordered configuration. -/
def pointIdeal {n p : ℕ} (a : PointCoordinates K n p) : Ideal (Poly K (n + 1)) :=
  ⨅ i : Fin p, singlePointIdeal K (fun j => a (i, j))

/-- Evaluation on a fixed homogeneous representative is a linear functional. -/
def evaluationLinear (n d : ℕ) (x : Fin n → K) : Forms K n d →ₗ[K] K where
  toFun f := MvPolynomial.eval x f.val
  map_add' f g := map_add (MvPolynomial.eval x) f.val g.val
  map_smul' c f := MvPolynomial.eval₂Hom_smul (RingHom.id K) x c f.val

/-- Evaluation of homogeneous forms at the normalized point representatives. -/
def pointEvaluation {n p : ℕ} (a : PointCoordinates K n p) (d : ℕ) :
    Forms K (n + 1) d →ₗ[K] (Fin p → K) :=
  LinearMap.pi (fun i => evaluationLinear K (n + 1) d (chartPoint K a i))

/-- Homogeneous forms that vanish on the point configuration. -/
def pointDegreePiece {n p : ℕ} (a : PointCoordinates K n p) (d : ℕ) :
    Submodule K (Forms K (n + 1) d) := LinearMap.ker (pointEvaluation K a d)

/-- The Hilbert function is the quotient dimension of the evaluation kernel. -/
def pointHilbertFunction {n p : ℕ} (a : PointCoordinates K n p) (d : ℕ) : ℕ :=
  finrank K ((Forms K (n + 1) d) ⧸ pointDegreePiece K a d)

variable {K}

@[simp] theorem pointEvaluation_apply {n p d : ℕ} (a : PointCoordinates K n p)
    (f : Forms K (n + 1) d) (i : Fin p) :
    pointEvaluation K a d f i = eval (chartPoint K a i) f.val := rfl

@[simp] theorem mem_pointDegreePiece {n p d : ℕ} (a : PointCoordinates K n p)
    (f : Forms K (n + 1) d) :
    f ∈ pointDegreePiece K a d ↔ ∀ i, eval (chartPoint K a i) f.val = 0 :=
  Iff.intro
    (fun h i => congrFun (show pointEvaluation K a d f = 0 from h) i)
    (fun h => show pointEvaluation K a d f = 0 from funext h)

/-- Multiplication by a fixed form, with the correct homogeneous target. -/
def mulForm {n d e : ℕ} (f : Forms K n d) : Forms K n e →ₗ[K] Forms K n (d + e) where
  toFun a := ⟨f.val * a.val, f.property.mul a.property⟩
  map_add' a b := Subtype.ext (mul_add f.val a.val b.val)
  map_smul' k a := Subtype.ext (mul_smul_comm k f.val a.val)

@[simp] theorem mulForm_val {n d e : ℕ} (f : Forms K n d) (a : Forms K n e) :
    (mulForm f a).val = f.val * a.val := rfl

def pointMultiplicationBilinear {n p : ℕ} (a : PointCoordinates K n p) (d : ℕ) :
    pointDegreePiece K a d →ₗ[K] Forms K (n + 1) 1 →ₗ[K] pointDegreePiece K a (d + 1) where
  toFun f := (mulForm f.val).codRestrict _ fun g => by
    apply (mem_pointDegreePiece a _).mpr
    intro i
    rw [mulForm_val, map_mul, (mem_pointDegreePiece a _).mp f.property i, zero_mul]
  map_add' f g := by
    apply LinearMap.ext
    intro u
    apply Subtype.ext
    apply Subtype.ext
    exact add_mul f.val.val g.val.val u.val
  map_smul' c f := by
    apply LinearMap.ext
    intro u
    apply Subtype.ext
    apply Subtype.ext
    exact smul_mul_assoc c f.val.val u.val

/-- Multiplication from the degree-`d` ideal piece tensored with the linear forms. -/
def pointTensorMultiplication {n p : ℕ} (a : PointCoordinates K n p) (d : ℕ) :
    (pointDegreePiece K a d ⊗[K] Forms K (n + 1) 1) →ₗ[K] pointDegreePiece K a (d + 1) :=
  TensorProduct.lift (pointMultiplicationBilinear a d)

/-- Maximal rank of a linear map between the finite-dimensional pieces. -/
def HasMaximalRank {V W : Type*} [AddCommMonoid V] [Module K V]
    [AddCommMonoid W] [Module K W] (f : V →ₗ[K] W) : Prop :=
  Function.Injective f ∨ Function.Surjective f

theorem snoc_one_ne_zero {n : ℕ} (u : Fin n → K) :
    (Fin.snoc u 1 : Fin (n + 1) → K) ≠ 0 :=
  fun h => one_ne_zero (show (1 : K) = 0 from
    (Fin.snoc_last (n := n) (α := fun _ => K) 1 u).symm.trans (congrFun h (Fin.last n)))

/-- The projective point represented by a chart coordinate with final coordinate one. -/
def projectiveChartPoint {n : ℕ} (u : Fin n → K) : Projectivization K (Fin (n + 1) → K) :=
  Projectivization.mk K (Fin.snoc u 1) (snoc_one_ne_zero u)

/-- The actual projective point family of a chart configuration. -/
def projectivePointFamily {n p : ℕ} (a : PointCoordinates K n p) (i : Fin p) :
    Projectivization K (Fin (n + 1) → K) :=
  projectiveChartPoint (fun j => a (i, j))

/-- The maximal-rank and minimal-generator assertions on the same nonempty open.
The index `n` is projective dimension, so the homogeneous ring has `n + 1` variables. -/
def TheoremOneOne (K : Type*) [Field K] : Prop :=
  ∀ n d p : ℕ, 1 ≤ n → 2 ≤ d →
    N (n + 1) (d - 1) ≤ p → p < N (n + 1) d →
    ∃ Δ : MvPolynomial (Fin p × Fin n) K,
      (∃ a : PointCoordinates K n p, eval a Δ ≠ 0) ∧
      ∀ a : PointCoordinates K n p, eval a Δ ≠ 0 →
        Function.Injective (projectivePointFamily a) ∧
        (pointIdeal K a).IsRadical ∧
        (∀ e, pointHilbertFunction K a e = min (N (n + 1) e) p) ∧
        HasMaximalRank (pointTensorMultiplication a d) ∧
        ∃ r : ℕ,
          (r : ℚ) = max 0 ((n : ℚ) * (E (n + 1) d - (N (n + 1) d - p : ℕ))) ∧
          ∃ g : Fin (N (n + 1) d - p) ⊕ Fin r → Poly K (n + 1),
            (∀ i, (g (.inl i)).IsHomogeneous d) ∧
            (∀ i, (g (.inr i)).IsHomogeneous (d + 1)) ∧
            Ideal.span (Set.range g) = pointIdeal K a ∧
            (∀ i, g i ∉ Ideal.span (g '' {j | j ≠ i})) ∧
            Function.Injective g

end PalomarModel.IdealGeneration

namespace IdealGenerationPaper

/-- Theorem 1.1 for an algebraically closed field of characteristic zero. -/
theorem main_result {K : Type*} [Field K] [CharZero K] [IsAlgClosed K] :
    PalomarModel.IdealGeneration.TheoremOneOne K := by sorry

end IdealGenerationPaper
